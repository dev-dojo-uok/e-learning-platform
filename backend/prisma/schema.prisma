datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum MaterialType {
  PDF
  FILE
  VIDEO_SRC
  VIDEO_EMBED
  QUIZ
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  courses      Course[]             @relation("UserCourses")
  completions  MaterialCompletion[] @relation("UserCompletions")
  quizAttempts QuizAttempt[]        @relation("UserQuizAttempts")

  @@map("users")
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  teacherId   String   @map("teacher_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  teacher  User            @relation("UserCourses", fields: [teacherId], references: [id], onDelete: Restrict)
  sections CourseSection[] @relation("CourseSections")
  quizzes  Quiz[]          @relation("CourseQuizzes")

  @@index([teacherId])
  @@map("courses")
}

model CourseSection {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  title     String
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  course    Course     @relation("CourseSections", fields: [courseId], references: [id], onDelete: Cascade)
  materials Material[] @relation("SectionMaterials")

  @@index([courseId, sortOrder])
  @@map("course_sections")
}

model Material {
  id            String       @id @default(uuid())
  sectionId     String       @map("section_id")
  title         String
  description   String?      @db.Text
  type          MaterialType
  contentUrl    String?      @map("content_url")
  embedCode     String?      @db.Text @map("embed_code")
  itemId        String?      @map("item_id")
  isGraded      Boolean      @default(false) @map("is_graded")
  gradingWeight Float        @default(0.0) @map("grading_weight")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  section     CourseSection        @relation("SectionMaterials", fields: [sectionId], references: [id], onDelete: Cascade)
  completions MaterialCompletion[] @relation("MaterialCompletions")

  @@index([sectionId])
  @@map("materials")
}

model MaterialCompletion {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  materialId  String   @map("material_id")
  completedAt DateTime @default(now()) @map("completed_at")

  // Relations
  student  User     @relation("UserCompletions", fields: [studentId], references: [id], onDelete: Cascade)
  material Material @relation("MaterialCompletions", fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([materialId])
  @@map("material_completions")
}

model Quiz {
  id               String        @id @default(uuid())
  courseId         String        @map("course_id")
  title            String
  hasTimeLimit     Boolean       @default(false) @map("has_time_limit")
  timeLimitMinutes Int           @default(0) @map("time_limit_minutes")
  minPassMark      Float         @default(0.0) @map("min_pass_mark")
  questionsJson    Json          @map("questions_json")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  course           Course        @relation("CourseQuizzes", fields: [courseId], references: [id], onDelete: Cascade)
  attempts         QuizAttempt[] @relation("QuizAttempts")

  @@index([courseId])
  @@map("quizzes")
}

model QuizAttempt {
  id                   String    @id @default(uuid())
  quizId               String    @map("quiz_id")
  studentId            String    @map("student_id")
  submittedAnswersJson Json?     @map("submitted_answers_json")
  score                Float?
  teacherFeedback      String?   @db.Text @map("teacher_feedback")
  startedAt            DateTime  @default(now()) @map("started_at")
  submittedAt          DateTime? @map("submitted_at")

  // Relations
  quiz                 Quiz      @relation("QuizAttempts", fields: [quizId], references: [id], onDelete: Cascade)
  student              User      @relation("UserQuizAttempts", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentId])
  @@map("quiz_attempts")
}
