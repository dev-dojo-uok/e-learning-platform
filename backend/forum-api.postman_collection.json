  "item": [
    {
      "name": "Forum",
      "item": [
        {
          "name": "Create Forum",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{COURSE_ID}}\",\n  \"moduleId\": \"{{MODULE_ID}}\",\n  \"name\": \"General Discussion\",\n  \"description\": \"Welcome to the general discussion forum for this course.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/forums",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forums"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Forums by Course",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/forums/{{COURSE_ID}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "forums",
                "{{COURSE_ID}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Single Forum",
          "request": {
            "method": "GET",
